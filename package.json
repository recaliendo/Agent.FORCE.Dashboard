{
  "name": "agent-force-dashboard",
  "version": "0.1.0",
  "description": "Desktop launch station for multi-project Codex, Claude Code, hybrid, and local agents.",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:compile": "tsc -p tsconfig.node.json",
    "qwen:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-qwen.ps1",
    "qwen:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-qwen.ps1",
    "qwen:verify": "node scripts/verify-local-qwen.mjs",
    "qwen:doctor": "tsc -p tsconfig.node.json && node scripts/qwen-doctor.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:preview": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsc -p tsconfig.node.json && node --test tests/*.test.mjs tests/*.test.ts",
    "lint:content": "node scripts/content-lint.mjs",
    "test:sse": "tsc -p tsconfig.node.json && node --test tests/sse-parser.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "com.agentforce.dashboard",
    "productName": "Agent FORCE Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
