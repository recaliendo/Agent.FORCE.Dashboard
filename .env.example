LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_NAME=Qwen/Qwen3.6-35B-A3B
LLM_API_KEY=
LLAMA_API_KEY=
LLM_TIMEOUT_SECONDS=5
# How long a request may wait for llama-server's single slot (queued behind
# another request, or the model still loading) before giving up.
LLM_QUEUE_TIMEOUT_SECONDS=180
# How long the stream may be completely silent. Progress frames and the
# server's 30 s keep-alive count as activity; values below 90 are raised to 90.
LLM_INFERENCE_INACTIVITY_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=512
LLM_AUTOSTART=true
LLM_STARTUP_TIMEOUT_SECONDS=180
LLAMA_RUNTIME_ROOT=
LLAMA_SERVER_PATH=
LLAMA_MODEL_PATH=
LLAMA_API_KEY_FILE=
LLAMA_GPU_LAYERS=all
LLAMA_CPU_MOE_LAYERS=32
LLAMA_LOAD_MODE=none
LLAMA_SPEC_TYPE=none
LLAMA_SPEC_DRAFT_N_MAX=2
LLAMA_CONTEXT_SIZE=8192
